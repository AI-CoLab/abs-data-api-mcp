{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Packages are consumed as TypeScript source: `exports` points at ./src/*.ts,
    // tsx runs them directly and wrangler bundles them. Nothing is ever emitted,
    // so explicit .ts import specifiers are both allowed and required.
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
